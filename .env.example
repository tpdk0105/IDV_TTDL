# Kaggle API Credentials (Copy to .env and fill in your values)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# NASA FIRMS API Map Key (Optional, for active fire archive download)
FIRMS_MAP_KEY=your_nasa_firms_map_key

# EM-DAT Credentials (If accessing via academic API)
EMDAT_EMAIL=your_email@university.edu
EMDAT_PASSWORD=your_password

# Data Paths (Defaults to project directory structure)
DATA_RAW_DIR=data/raw
DATA_CLEAN_DIR=data/clean
DATA_TABLES_DIR=data/tables
DATABASE_PATH=data/tables/database.sqlite
